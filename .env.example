# Copy to .env (`cp .env.example .env`) and fill in. .env is git-ignored: NEVER commit real keys.
# docker-compose reads it for the `api` service.

# ---- App -------------------------------------------------------------------------------------
# Public URL users type in the browser. Used for email links, cookie security and the CSRF origin check.
# Production example: https://studio.pathy.ai  (https => cookies are marked Secure)
APP_URL=http://localhost:3000
# Extra browser origins allowed to call the API, comma separated (usually empty).
ALLOWED_ORIGINS=
# "development": unset keys fall back to dev helpers (emails printed in the api log, mock AI).
# "production": unset keys disable the feature instead.
NODE_ENV=development

# ---- Slide renderer (optional) ---------------------------------------------------------------
# Default: the local rslides container. To use a remote rslides (e.g. on Google Cloud Run) set its base URL:
# RSLIDES_URL=https://<your-rslides-service>.run.app

# ---- Database (Postgres) ------------------------------------------------------------------------
# Leave empty locally: docker-compose starts its own Postgres. On Vercel, create a Postgres database
# (Storage tab -> Neon) and it injects DATABASE_URL / POSTGRES_URL for you. Use the pooled connection string.
DATABASE_URL=

# ---- Private slides (fs-slides) ---------------------------------------------------------------
# fs-slides no longer uses Auth0: it trusts short-lived tokens issued by this app (POST /api/auth/slides-token)
# and verifies them with this shared secret. The SAME value must be set as SLIDES_TOKEN_SECRET on fs-slides.
# Generate one with:  openssl rand -base64 48      Never commit it.
SLIDES_TOKEN_SECRET=
# Optional, defaults shown (must match fs-slides if you change them):
# AUTH_ISSUER=pathy-studio
# AUTH_AUDIENCE=fs-slides

# ---- Email confirmation: Resend (https://resend.com) ------------------------------------------
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown on the confirmation email. The default only delivers to YOUR Resend account's own
# address (sandbox). To email real users, verify your domain at https://resend.com/domains and use
# e.g. "Pathy <no-reply@pathy.ai>".
EMAIL_FROM=Pathy <onboarding@resend.dev>

# ---- Google sign-in ---------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > "Web application".
# Add your APP_URL (e.g. http://localhost:3000) under "Authorized JavaScript origins".
# Only the client ID is needed (ID-token flow): there is no client secret to store.
GOOGLE_CLIENT_ID=

# ---- Local LLM for testing (optional) ---------------------------------------------------------
# Local / self-hosted LLM instead of Anthropic: any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio).
# Used only when ANTHROPIC_API_KEY is empty. Needs a vision-capable model.
# Local test with the bundled Ollama container:
#   docker-compose --profile llm up -d ollama && docker-compose exec ollama ollama pull qwen2.5vl:3b
# then set LLM_BASE_URL=http://ollama:11434/v1 and LLM_MODEL=qwen2.5vl:3b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- AI chat: Anthropic (https://console.anthropic.com) ---------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI messages each user may send per (UTC) day.
AI_DAILY_LIMIT=30
