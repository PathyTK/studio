# Sourced by the nginx entrypoint before envsubst: derive the Host header for each upstream.
export RSLIDES_HOST=$(echo "$RSLIDES_URL" | sed -E 's#^[a-z]+://([^/]+).*#\1#')
export FS_SLIDES_HOST=$(echo "$FS_SLIDES_URL" | sed -E 's#^[a-z]+://([^/]+).*#\1#')
export API_HOST=$(echo "$API_URL" | sed -E 's#^[a-z]+://([^/]+).*#\1#')
