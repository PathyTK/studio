server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    gzip on;

    # Uploaded slides (upload in chunks, list, open, tiles) live in fs-slides: it authenticates the caller itself
    # (studio token or X-Session-Id), so the headers must reach it untouched. Chunks are 8 MB; fs-slides enforces quotas.
    location /api/fs {
        client_max_body_size 64m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass ${FS_SLIDES_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${FS_SLIDES_HOST};
    }

    # Accounts + AI go to the pathy-api service (same origin, so the session cookie just works).
    location /api/annotations {
        client_max_body_size 4m;
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/auth/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # AI answers stream token by token: no buffering, generous timeout, room for the screenshots in the request.
    location /api/ai/ {
        client_max_body_size 16m;
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;   # a local CPU model can take minutes to start answering
    }

    # Same-origin proxy to rslides: no CORS, no mixed content.
    location /api/ {
        proxy_pass ${RSLIDES_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${RSLIDES_HOST};
        proxy_buffering on;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
